#!/bin/sh
# Shows a screensaver after the screen has been idle, and turns the display
# off later. Started at login for every user via /etc/xdg/autostart.
#
#   toastsaver-idle                run the idle watcher (normally done at login)
#   toastsaver-idle --now [SAVER]  show the chosen saver (or SAVER) right now
#   toastsaver-idle --check        explain what is and isn't working
#   toastsaver-idle --restart      apply new settings now (the settings page does this)
#   toastsaver-idle --stop         stop the watcher

BIN="@BINDIR@/toastsaver"       # filled in by 'make install'
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/toastsaver.conf"
ENABLED=1               # 0 = never start the screensaver
IDLE_MINUTES=5          # minutes of no input before the screensaver appears
SCREEN_OFF_MINUTES=30   # minutes before the display turns off (0 = never)
SAVER=toasters
CLOCK=0
# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF"
# Seconds overrides exist for testing; normal settings are in minutes.
IDLE_SECONDS=${IDLE_SECONDS:-$((IDLE_MINUTES * 60))}
SCREEN_OFF_SECONDS=${SCREEN_OFF_SECONDS:-$((SCREEN_OFF_MINUTES * 60))}

# PIDs of our swayidle watchers. Checks the process name exactly and then its
# arguments, so it can't match some other program that mentions "toastsaver".
watcher_pids() {
    for pid in $(pgrep -x swayidle); do
        tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q "$BIN" && echo "$pid"
    done
}

first_file() {
    for f in "$@"; do [ -f "$f" ] && { echo "$f"; return 0; }; done
    return 1
}

check() {
    ok() { printf '  ok    %s\n' "$1"; }
    bad() { printf '  FAIL  %s\n' "$1"; }
    note() { printf '  note  %s\n' "$1"; }
    echo "toastsaver check"
    if [ -x "$BIN" ]; then ok "$BIN installed"; else bad "$BIN missing"; fi
    if command -v swayidle >/dev/null; then ok "swayidle installed"; else bad "swayidle missing (sudo apt install swayidle)"; fi
    if [ -n "${WAYLAND_DISPLAY:-}" ]; then ok "Wayland session ($WAYLAND_DISPLAY)"; else bad "not a Wayland session (session type: ${XDG_SESSION_TYPE:-unknown})"; fi
    comp=$(pgrep -l -x 'labwc|wayfire|sway|Hyprland|river' | awk '{print $2}' | head -n1)
    if [ -n "$comp" ]; then ok "compositor: $comp"; else note "no labwc/wayfire/sway/Hyprland/river found; other desktops may not support idle detection"; fi
    if first_file /etc/xdg/autostart/toastsaver.desktop "$HOME/.config/autostart/toastsaver.desktop" >/dev/null; then ok "starts at login"; else bad "autostart entry missing"; fi
    if [ "$ENABLED" = 0 ]; then note "turned OFF in settings (ENABLED=0)"
    elif [ -n "$(watcher_pids)" ]; then ok "idle watcher running"
    else bad "idle watcher not running (log out and back in, or run: toastsaver-idle --restart)"; fi
    if first_file /usr/share/applications/toastsaver-picker.desktop /usr/local/share/applications/toastsaver-picker.desktop >/dev/null; then ok "Screensavers in the app menu"; else bad "menu entries missing"; fi
    if command -v wlopm >/dev/null; then ok "wlopm available (screen off after $SCREEN_OFF_MINUTES min)"; else note "wlopm not installed; display won't be turned off by toastsaver"; fi
    echo "  settings: '$SAVER' after $IDLE_MINUTES min, clock $CLOCK ($CONF)"
}

case "${1:-}" in
    --check) check; exit 0 ;;
    --now) shift; exec "$BIN" "$@" ;;
    --stop)
        pids=$(watcher_pids)
        # shellcheck disable=SC2086  # one word per PID is intended
        [ -n "$pids" ] && kill $pids
        exit 0 ;;
    --restart)
        pids=$(watcher_pids)
        # shellcheck disable=SC2086  # one word per PID is intended
        [ -n "$pids" ] && kill $pids && sleep 0.3
        [ -n "${WAYLAND_DISPLAY:-}" ] && setsid -f "$0" >/dev/null 2>&1
        exit 0 ;;
    "") ;;
    *) echo "usage: toastsaver-idle [--now [SAVER]|--check|--restart|--stop]" >&2; exit 2 ;;
esac

[ "$ENABLED" = 0 ] && exit 0                     # switched off in settings
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    echo "toastsaver-idle: needs a Wayland session" >&2
    exit 0                                       # quietly do nothing on X11 logins
fi

# One watcher per login session.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/toastsaver-idle.lock"
flock -n 9 || exit 0

# The saver reads its settings each time it starts, so picker changes apply at once.
# 'pkill -x toastsaver' doesn't touch the picker or settings (different process names).
# fd 9 is closed for children so the lock only lives as long as swayidle.
set -- timeout "$IDLE_SECONDS" "$BIN 9>&- &" resume 'pkill -x toastsaver'
if [ "$SCREEN_OFF_SECONDS" -gt 0 ] && command -v wlopm >/dev/null; then
    set -- "$@" timeout "$SCREEN_OFF_SECONDS" 'wlopm --off "*"' resume 'wlopm --on "*"'
fi

# swayidle only sees what the compositor sees, and gamepads/joysticks usually never reach it.
# So watch the joystick event devices ourselves: any activity restarts swayidle, which resets
# its timers (and wakes the display / ends the saver if they were already up).
start_idle() { swayidle -w "$@" 9>&- & SWAYIDLE=$!; }
pads() { ls /dev/input/by-id/*-event-joystick /dev/input/by-path/*-event-joystick 2>/dev/null; }

FLAG="${XDG_RUNTIME_DIR:-/tmp}/toastsaver-pad.$$"
READERS=
stop_readers() { for r in $READERS; do pkill -P "$r" 2>/dev/null; kill "$r" 2>/dev/null; done; READERS=; }
cleanup() { stop_readers; rm -f "$FLAG"; kill "$SWAYIDLE" 2>/dev/null; exit 0; }
trap cleanup INT TERM HUP

start_idle "$@"
[ -z "$(pads)" ] && { wait "$SWAYIDLE"; exit; }   # fast path when no pads are plugged in at start

while kill -0 "$SWAYIDLE" 2>/dev/null; do
    rm -f "$FLAG"
    for d in $(pads); do
        [ -r "$d" ] || continue
        (dd if="$d" of=/dev/null bs=256 count=1 2>/dev/null && : >"$FLAG") 9>&- &
        READERS="$READERS $!"
    done
    # Poll for activity (or a new pad being plugged in) every couple of seconds.
    n=0
    while [ ! -e "$FLAG" ] && [ $n -lt 15 ] && kill -0 "$SWAYIDLE" 2>/dev/null; do
        sleep 2; n=$((n + 1))
    done
    stop_readers
    if [ -e "$FLAG" ]; then
        kill "$SWAYIDLE" 2>/dev/null; wait "$SWAYIDLE" 2>/dev/null
        pkill -x toastsaver
        command -v wlopm >/dev/null && wlopm --on "*"
        start_idle "$@"
    fi
done
