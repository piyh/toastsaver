# Maintainer: piyh <10518137+piyh@users.noreply.github.com>
pkgname=toastsaver
pkgver=1.3.0
pkgrel=1
pkgdesc="Retro screensavers for Wayland: flying toasters, 3D pipes, aquarium and more, with a kid-friendly picker"
arch=('x86_64' 'aarch64' 'armv7h')
url="https://github.com/piyh/toastsaver"
license=('MIT')
# swayidle and procps-ng are run by toastsaver-idle; libglvnd is loaded by SDL at runtime.
depends=('sdl2' 'swayidle' 'procps-ng' 'libglvnd' 'hicolor-icon-theme')
makedepends=('pkgconf')
optdepends=('wlopm: turn the display off after a while')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::https://github.com/piyh/toastsaver/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('34aa35fa851c6d0bedae36ba29647c118fb57170c18226f08bc2fb3d17401dc6')

build() {
    cd "$pkgname-$pkgver"
    make PREFIX=/usr
}

package() {
    cd "$pkgname-$pkgver"
    make install PREFIX=/usr SYSCONFDIR=/etc DESTDIR="$pkgdir"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
